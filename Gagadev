KickBtn.MouseButton1Click:Connect(function()
    if targetPlayer then
        local reason = ReasonBox.Text
        if reason == "" then reason = "GagaDev Hub" end
        
        -- Se o alvo for você mesmo, kicka direto na hora
        if targetPlayer == LocalPlayer.Name then
            LocalPlayer:Kick("Você se kickou: " .. reason)
        else
            -- Se for outro, manda a mensagem criptografada pro chat
            local message = "gaga_sys_" .. encode("KICK:" .. targetPlayer .. ":" .. reason)
            
            pcall(function()
                ReplicatedStorage.DefaultChatSystemChatEvents.SayMessageRequest:FireServer(message, "All")
            end)

            KickBtn.Text = "COMANDO ENVIADO!"
            task.wait(1.5)
            KickBtn.Text = "KICKAR SELECIONADO"
        end
    else
        KickBtn.Text = "SELECIONE ALGUÉM ACIMA!"
        task.wait(1.5)
        KickBtn.Text = "KICKAR SELECIONADO"
    end
end)
