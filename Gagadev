-- ==========================================
-- CRIPTOGRAFIA
-- ==========================================
local function encode(str)
    return (str:gsub(".", function(c) return string.format("%02x", string.byte(c)) end))
end

local function decode(hex)
    return (hex:gsub("%x%x", function(cc) return string.char(tonumber(cc, 16)) end))
end

-- ==========================================
-- RECEBEDOR DO KICK
-- ==========================================
LocalPlayer.Chatted:Connect(function(message)
    if string.sub(message, 1, 9) == "gaga_sys_" then
        local encoded = string.sub(message, 10)
        local decoded = decode(encoded)
        local target, reason = string.match(decoded, "KICK:([^:]+):(.+)")
        
        if target and target == LocalPlayer.Name then
            LocalPlayer:Kick("GagaDev Kick System: " .. tostring(reason))
        end
    end
end)

