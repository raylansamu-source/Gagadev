local targetPlayer = nil
local playerButtons = {}

local function updatePlayerList()
    for _, btn in pairs(playerButtons) do
        btn:Destroy()
    end
    playerButtons = {}
    
    for _, p in pairs(Players:GetPlayers()) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 30)
        btn.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
        
        -- Destaque pro próprio jogador
        if p == LocalPlayer then
            btn.Text = p.Name .. " (Você)"
            btn.TextColor3 = Color3.fromRGB(255, 200, 100) -- Cor amarela
        else
            btn.Text = p.Name
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        end
        
        btn.Font = Enum.Font.Gotham
        btn.TextSize = 12
        btn.Parent = ScrollingFrame
        
        local corner = Instance.new("UICorner", btn)
        corner.CornerRadius = UDim.new(0, 4)

        btn.MouseButton1Click:Connect(function()
            targetPlayer = p.Name
            for _, b in pairs(playerButtons) do
                b.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
            end
            btn.BackgroundColor3 = Color3.fromRGB(160, 60, 255)
        end)
        
        table.insert(playerButtons, btn)
    end
    ScrollingFrame.CanvasSize = UDim2.new(0, 0, 0, #playerButtons * 34)
end

updatePlayerList()
Players.PlayerAdded:Connect(updatePlayerList)
Players.PlayerRemoving:Connect(updatePlayerList)

